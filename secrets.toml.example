# For Streamlit Community Cloud: paste these into  App settings -> Secrets
GEMINI_API_KEY = "your-gemini-key"
MONGODB_URI = "mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB = "postpilot"                 # optional: database name
# SIGNUP_CODE = "choose-an-invite-code"   # optional: only people with this code can create accounts
# MAX_GENERATIONS = "20"                  # optional: posts allowed per visit
