# Copy this file to ".env" and paste your free Gemini key below (no quotes, no spaces)
GEMINI_API_KEY=your-api-key-here
# Optional: LinkedIn Access Token for direct uploading & automated scheduling (or connect via the UI)
LINKEDIN_ACCESS_TOKEN=
# Optional: change the model (default is gemini-flash-latest)
# MODEL=gemini-flash-latest
# Optional: only people with this code can create accounts
# SIGNUP_CODE=choose-an-invite-code
# Online database (needed when deployed; see README). Leave it out to use a local file instead.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
